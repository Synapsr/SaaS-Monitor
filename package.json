{
  "name": "saas-monitor",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Open-source, real-time Stripe dashboard for SaaS founders. Put your MRR on a wall screen and hear every sale.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Synapsr/SaaS-Monitor.git"
  },
  "bugs": {
    "url": "https://github.com/Synapsr/SaaS-Monitor/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose -f compose.dev.yaml up -d --wait",
    "db:down": "docker compose -f compose.dev.yaml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@number-flow/react": "0.6.2",
    "better-auth": "1.7.18",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.2",
    "d3-scale": "4.0.3",
    "d3-shape": "3.2.1",
    "d3-time": "3.1.1",
    "drizzle-orm": "0.45.4",
    "geist": "1.9.1",
    "gleap": "^19.3.9",
    "lucide-react": "1.70.0",
    "motion": "13.4.4",
    "mysql2": "3.24.6",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "stripe": "22.6.2",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/canvas-confetti": "1.9.0",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/d3-time": "3.0.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}

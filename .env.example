# Copy this file to `.env` and adjust the values.
# Generate secrets with: openssl rand -hex 32

# Public URL of the app, without trailing slash. Used for auth callbacks and screen links.
APP_URL=http://localhost:3000

# PostgreSQL connection string. `pnpm db:up` starts a local database matching this URL.
DATABASE_URL=postgres://saas_monitor:saas_monitor@127.0.0.1:5433/saas_monitor

# Signs sessions. At least 32 characters.
AUTH_SECRET=

# Encrypts Stripe API keys at rest. Exactly 64 hexadecimal characters (32 bytes).
# Changing it makes existing Stripe connections unreadable: they must be reconnected.
ENCRYPTION_KEY=

# Set to `true` to close registrations once your team has signed up.
DISABLE_SIGNUPS=false

# Optional social sign-in. Leave empty to disable.
# GitHub callback URL: ${APP_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google callback URL: ${APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Exchange rates used to combine accounts billed in different currencies (ECB data, no key needed).
FX_RATES_URL=https://api.frankfurter.dev/v1

# Copy this file to `.env` and fill in the secrets, or run `node scripts/setup.mjs` to generate
# them. Generate a secret by hand with: openssl rand -hex 32

# Public URL of the app, without trailing slash. Used for sign-in callbacks, screen links and
# Stripe webhooks (instant updates need a public https URL).
APP_URL=http://localhost:3000

# Signs sessions. At least 32 characters.
AUTH_SECRET=

# Encrypts Stripe API keys at rest: exactly 64 hexadecimal characters (32 bytes).
# Keep it safe and stable: if it changes, Stripe accounts must be connected again.
ENCRYPTION_KEY=

# Set to `true` once your team has signed up: only invited people can then create an account.
DISABLE_SIGNUPS=false

# Optional social sign-in. Leave empty to disable.
# GitHub callback URL: <APP_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google callback URL: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Docker Compose (compose.yaml) ---------------------------------------------------------
# Passwords of the bundled MySQL database: the app's user, and root.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Port published on the host.
APP_PORT=3000

# --- Local development (compose.dev.yaml, `pnpm db:up`) ------------------------------------
DATABASE_URL=mysql://saas_monitor:saas_monitor@127.0.0.1:3307/saas_monitor

# --- Voice announcements ------------------------------------------------------------------
# Optional. Screens say recorded phrases without it; with a Gradium API key (https://gradium.ai),
# they can say their own, with the customer's name, the amount and the plan.
GRADIUM_API_KEY=

# --- Advanced ------------------------------------------------------------------------------
# Apply database migrations when the server starts.
MIGRATE_ON_START=true
# Exchange rates used to combine accounts billed in different currencies (ECB data, no key).
FX_RATES_URL=https://api.frankfurter.dev/v1
# Gradium's API. Its eu. and us. hosts keep processing in a region, for accounts that enabled it.
GRADIUM_API_URL=https://api.gradium.ai/api

# --- Analytics (optional, off by default) --------------------------------------------------
# Counts visits and a few steps (demo, sign-up, Stripe connected) with Plausible: no cookies,
# ids and tokens removed from URLs, screens never counted. Browsers only talk to this app, which
# relays to Plausible. Leave unset and nothing is loaded or sent.
# The site's domain as registered in Plausible:
# PLAUSIBLE_DOMAIN=monitor.example.com
# Plausible's server, if not plausible.io (e.g. your own Plausible Community Edition):
# PLAUSIBLE_HOST=https://plausible.io

# --- Hosted instance ------------------------------------------------------------------------
# saas-monitor.com only: moments and milestones credit "saas-monitor.com", which each screen can
# turn off in its settings. Self-hosted servers leave it unset and show no credit.
# SHOW_ATTRIBUTION=true

<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds take screens from adb when no phone is paired (DebugScreensReceiver), e.g. of a
  local web dev server (the emulator's host is 10.0.2.2). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <receiver
      android:name=".DebugScreensReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="com.saasmonitor.wear.DEBUG_SCREENS" />
      </intent-filter>
    </receiver>
  </application>
</manifest>

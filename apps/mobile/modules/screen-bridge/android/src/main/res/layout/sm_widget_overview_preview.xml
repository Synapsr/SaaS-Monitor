<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows before Android 15, which renders the real widget instead. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/sm_preview_background"
  android:orientation="vertical"
  android:padding="14dp">
  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/sm_app_name"
    android:textColor="#A8ADB5"
    android:textSize="12sp" />
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:orientation="horizontal">
    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MRR"
        android:textColor="#80858E"
        android:textSize="12sp" />
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="$12,480"
        android:textColor="#F4F5F7"
        android:textSize="28sp" />
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/sm_preview_pill"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="+$1,120 · +9.9%"
        android:textColor="#6EE7B7"
        android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="14dp"
      android:layout_weight="1"
      android:orientation="vertical">
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Revenue today"
        android:textColor="#80858E"
        android:textSize="12sp" />
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="$1,240"
        android:textColor="#F4F5F7"
        android:textSize="18sp" />
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Goal $15K MRR · 83%"
        android:textColor="#A8ADB5"
        android:textSize="12sp" />
      <ProgressBar
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="5dp"
        android:max="100"
        android:progress="83"
        android:progressTint="#34D399" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
